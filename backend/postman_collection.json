{
  "info": {
    "name": "Music Platform API",
    "_postman_id": "music-platform-collection",
    "description": "Collection for Music Platform backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup Artist",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Indie Artist\",\n  \"email\": \"indie@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/signup/artist", "host": ["{{baseUrl}}"], "path": ["auth","signup","artist"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"indie@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"artist\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          }
        }
      ]
    },
    {
      "name": "Artists",
      "item": [
        {
          "name": "Featured Artists",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/artists/featured", "host": ["{{baseUrl}}"], "path": ["artists","featured"] } }
        },
        {
          "name": "Search Artists",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/artists/search?q=indie", "host": ["{{baseUrl}}"], "path": ["artists","search"], "query": [{ "key": "q", "value": "indie" }] } }
        }
      ]
    },
    {
      "name": "Opportunities",
      "item": [
        {
          "name": "Create Opportunity",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Weekend Gig\",\n  \"event_date\": \"2025-11-15\",\n  \"event_time\": \"20:00\"\n}" },
            "url": { "raw": "{{baseUrl}}/opportunities", "host": ["{{baseUrl}}"], "path": ["opportunities"] }
          }
        },
        {
          "name": "List Opportunities",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/opportunities", "host": ["{{baseUrl}}"], "path": ["opportunities"] } }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Apply to Opportunity",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{ \"artist_id\": 12 }" },
            "url": { "raw": "{{baseUrl}}/applications/5/apply", "host": ["{{baseUrl}}"], "path": ["applications","5","apply"] }
          }
        },
        {
          "name": "Club Applications",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/applications/club", "host": ["{{baseUrl}}"], "path": ["applications","club"] } }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "List Bookings",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] } }
        },
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{ \"artist_id\": 12, \"opportunity_id\": 5, \"fee\": 500 }" },
            "url": { "raw": "{{baseUrl}}/bookings", "host": ["{{baseUrl}}"], "path": ["bookings"] }
          }
        }
      ]
    },
    {
      "name": "Chats",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "raw", "raw": "{ \"sender_type\": \"artist\", \"sender_id\": 12, \"receiver_type\": \"club\", \"receiver_id\": 3, \"message\": \"Hello\" }" },
            "url": { "raw": "{{baseUrl}}/chats", "host": ["{{baseUrl}}"], "path": ["chats"] }
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Upload Media (multipart)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "body": { "mode": "formdata", "formdata": [ { "key": "file", "type": "file" } ] },
            "url": { "raw": "{{baseUrl}}/media", "host": ["{{baseUrl}}"], "path": ["media"] }
          }
        }
      ]
    },
    {
      "name": "Venues",
      "item": [
        { "name": "Search Venues", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/venues/search?q=club", "host": ["{{baseUrl}}"], "path": ["venues","search"], "query": [{ "key": "q", "value": "club" }] } } },
        { "name": "Featured Venues", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/venues/featured", "host": ["{{baseUrl}}"], "path": ["venues","featured"] } } }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:3000" },
    { "key": "token", "value": "" }
  ]
}
